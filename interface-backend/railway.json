{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "interface-backend/Dockerfile",
    "watchPatterns": [
      "/interface-backend/**",
      "/customizations/correct_answers.py"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
