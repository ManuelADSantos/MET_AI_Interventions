{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "interface-backend/Dockerfile"
  },
  "deploy": {
    "startCommand": "gunicorn --reload --workers 2 --threads 64 --timeout 180 --bind 0.0.0.0:5001 app:app",
    "healthcheckPath": "/",
    "healthcheckTimeout": 20
  }
}
