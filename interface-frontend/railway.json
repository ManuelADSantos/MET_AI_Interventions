{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "interface-frontend/Dockerfile",
    "watchPatterns": [
      "/interface-frontend/**",
      "/customizations/tasks/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
